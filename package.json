{
  "name": "nana-rn",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:device": "expo start --lan",
    "start:dev-client": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-node.ps1 ./node_modules/expo/bin/cli start --dev-client",
    "clean:generated": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean-generated.ps1",
    "android:generate": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/sync-android.ps1",
    "android:build:debug": "powershell -NoProfile -Command \"$env:NODE_ENV='development'; & './android/gradlew.bat' -p './android' ':app:assembleDebug'\"",
    "android:studio": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/open-android-studio.ps1",
    "build:android:preview": "npx eas-cli build -p android --profile preview",
    "build:android:dev": "npx eas-cli build -p android --profile development",
    "build:ios:dev": "npx eas-cli build -p ios --profile development",
    "build:dev": "npx eas-cli build --profile development",
    "eas:login": "npx eas-cli login",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "smoke:ui": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-node.ps1 ./scripts/smoke-ui.mjs",
    "smoke:localization": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-node.ps1 ./scripts/smoke-localization.mjs",
    "test:text": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-node.ps1 ./scripts/check-text-integrity.mjs",
    "test:media": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-node.ps1 ./scripts/check-media-runtime-contract.mjs",
    "test:voice-gesture": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-node.ps1 ./scripts/check-voice-gesture-contract.mjs",
    "test:call-audio-route": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-node.ps1 ./scripts/check-call-audio-route-contract.mjs",
    "test:call-voice-activity": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-node.ps1 ./scripts/check-call-voice-activity-contract.mjs",
    "test:payment": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-node.ps1 ./scripts/check-payment-contract.mjs",
    "test:trace": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-node.ps1 ./scripts/check-relationship-trace-contract.mjs",
    "test:memory-context": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-node.ps1 ./scripts/check-memory-context-contract.mjs",
    "test:memory-correction": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-node.ps1 ./scripts/check-memory-correction-contract.mjs",
    "test:chat": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-node.ps1 ./scripts/check-chat-request-contract.mjs",
    "test:chat-rhythm": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-node.ps1 ./scripts/check-chat-rhythm-contract.mjs",
    "test:message-delivery": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-node.ps1 ./scripts/check-message-delivery-contract.mjs",
    "test:proactive-chat": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-node.ps1 ./scripts/check-proactive-chat-contract.mjs",
    "test:chat-storage": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-node.ps1 ./scripts/check-chat-storage-contract.mjs",
    "test:storage": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-node.ps1 ./scripts/check-storage-contract.mjs",
    "test:glass": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-node.ps1 ./scripts/check-glass-material-contract.mjs",
    "lint": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-node.ps1 ./node_modules/eslint/bin/eslint.js ."
  },
